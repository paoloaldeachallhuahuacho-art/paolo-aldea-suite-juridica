rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 1. Sesión Firebase Auth válida (nunca anónima sin perfil de worker)
    function isAuthenticated() {
      return request.auth != null
        && request.auth.uid != null
        && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    // 2. Perfil del colaborador en /workers/{uid}
    function hasWorkerProfile() {
      return isAuthenticated() && exists(/databases/$(database)/documents/workers/$(request.auth.uid));
    }

    function getWorkerProfile() {
      return get(/databases/$(database)/documents/workers/$(request.auth.uid)).data;
    }

    // 3. Admin global: solo vía perfil worker o custom claims verificados por Admin SDK
    //    (eliminados emails hardcodeados y token.rol sin claims reales — Semana 2 / S18)
    function isAdmin() {
      return isAuthenticated() && (
        (request.auth.token.rol is string && request.auth.token.rol in ['super_admin', 'admin', 'socio']) ||
        (hasWorkerProfile() && getWorkerProfile().rol in ['super_admin', 'admin', 'socio'])
      );
    }

    // 4. Aislamiento por sede — documentos SIN sede se deniegan (S4)
    function canAccessSedeData(docData) {
      return isAdmin() || (
        hasWorkerProfile() &&
        ('sede' in docData) &&
        (
          getWorkerProfile().sede in ['todas', 'global'] ||
          docData.sede == getWorkerProfile().sede
        )
      );
    }

    function isValidPayload() {
      return request.resource.data.keys().size() <= 120;
    }

    // Prohibir secretos de autenticación en la nube (S5)
    function hasNoAuthSecrets() {
      return !('password' in request.resource.data)
        && !('pin' in request.resource.data)
        && !('clave' in request.resource.data)
        && !('passwordHash' in request.resource.data)
        && !('pinHash' in request.resource.data)
        && !('passwordPlain' in request.resource.data)
        && !('pinPlain' in request.resource.data);
    }

    match /_meta/{metaId} {
      allow read: if isAuthenticated() && hasWorkerProfile();
      allow write: if isAdmin() && isValidPayload();
    }

    match /casos/{casoId} {
      allow read: if isAuthenticated() && canAccessSedeData(resource.data);
      allow create, update: if isAuthenticated() && isValidPayload() && canAccessSedeData(request.resource.data);
      allow delete: if isAdmin() || (isAuthenticated() && canAccessSedeData(resource.data));
    }

    match /caja_chica/{movId} {
      allow read: if isAuthenticated() && canAccessSedeData(resource.data);
      allow create, update: if isAuthenticated() && isValidPayload() && canAccessSedeData(request.resource.data);
      allow delete: if isAdmin() || (isAuthenticated() && canAccessSedeData(resource.data));
    }

    match /attendance/{asistenciaId} {
      allow read: if isAuthenticated() && canAccessSedeData(resource.data);
      allow create: if isAuthenticated() && isValidPayload() && canAccessSedeData(request.resource.data)
        && (!('uid' in request.resource.data) || request.resource.data.uid == request.auth.uid);
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /workers/{workerId} {
      allow read: if isAdmin() || (isAuthenticated() && workerId == request.auth.uid);
      allow create: if isAdmin() && isValidPayload() && hasNoAuthSecrets();
      allow delete: if isAdmin();
      allow update: if hasNoAuthSecrets() && (
        isAdmin() || (isAuthenticated() && workerId == request.auth.uid
          && request.resource.data.get('rol', null) == resource.data.get('rol', null)
          && request.resource.data.get('sede', null) == resource.data.get('sede', null)
          && request.resource.data.get('permisos', null) == resource.data.get('permisos', null))
      );
    }

    match /citas/{citaId} {
      allow read: if isAuthenticated() && canAccessSedeData(resource.data);
      allow create, update: if isAuthenticated() && isValidPayload() && canAccessSedeData(request.resource.data);
      allow delete: if isAdmin() || (isAuthenticated() && canAccessSedeData(resource.data));
    }

    match /documentos/{docId} {
      allow read: if isAuthenticated() && canAccessSedeData(resource.data);
      allow create, update: if isAuthenticated() && isValidPayload() && canAccessSedeData(request.resource.data);
      allow delete: if isAdmin() || (isAuthenticated() && canAccessSedeData(resource.data));
    }

    match /inventario/{invId} {
      allow read: if isAuthenticated() && canAccessSedeData(resource.data);
      allow create, update: if isAuthenticated() && isValidPayload() && canAccessSedeData(request.resource.data);
      allow delete: if isAdmin() || (isAuthenticated() && canAccessSedeData(resource.data));
    }

    match /presupuestos/{presId} {
      allow read: if isAuthenticated() && canAccessSedeData(resource.data);
      allow create, update: if isAuthenticated() && isValidPayload() && canAccessSedeData(request.resource.data);
      allow delete: if isAdmin() || (isAuthenticated() && canAccessSedeData(resource.data));
    }

    match /auditoria/{audId} {
      allow read: if isAdmin();
      allow create: if isAuthenticated() && isValidPayload();
      allow update, delete: if false;
    }

    // Deny-by-default: colecciones no declaradas quedan bloqueadas (S4 catch-all)
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
