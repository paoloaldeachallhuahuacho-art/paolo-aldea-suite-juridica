{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "**/tests/**",
      "**/supabase/**",
      "**/docs/**",
      "**/netlify/**",
      "**/herramientas/**",
      "package-lock.json",
      "*.ps1",
      "*.bat",
      "*.vbs",
      "*.sql",
      ".env*"
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  }
}
