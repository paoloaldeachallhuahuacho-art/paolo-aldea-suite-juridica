# ==============================================================================
# PAOLO ALDEA — Variables de entorno (Netlify / local)
# Copiar a Netlify UI o .env local. NUNCA commitear secretos reales.
# ==============================================================================

# Orígenes permitidos (exact match)
ALLOWED_ORIGIN=https://su-dominio.netlify.app

# --- Supabase (Modo B Enterprise) ---
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOi...anon
# Solo Netlify Functions / backend — NUNCA en el cliente
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...service_role

# --- Firebase (Auth / token verify para Telegram) ---
FIREBASE_API_KEY=
FIREBASE_PROJECT_ID=
FIREBASE_APP_ID=
FIREBASE_MESSAGING_SENDER_ID=

# --- Telegram proxy (solo server) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
