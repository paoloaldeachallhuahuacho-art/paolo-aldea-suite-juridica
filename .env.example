# ==============================================================================
# PAOLO ALDEA — Variables de entorno (Netlify / local)
# Copiar a Netlify UI o .env local. NUNCA commitear secretos reales.
# ==============================================================================

# Orígenes permitidos (exact match, sin barra final)
ALLOWED_ORIGIN=https://su-dominio.netlify.app

# --- Supabase (Modo B Enterprise) ---
SUPABASE_URL=https://TU_PROYECTO.supabase.co
# Pegar desde Supabase → Settings → API (anon / service_role). No uses ejemplos con "eyJ...".
SUPABASE_ANON_KEY=REEMPLAZAR_CON_SUPABASE_ANON_KEY
# Opcional admin / jobs internos — NUNCA en el cliente.
# attendance-validate y petty-cash-transition NO lo usan (RPC con JWT de usuario).
SUPABASE_SERVICE_ROLE_KEY=REEMPLAZAR_CON_SUPABASE_SERVICE_ROLE_KEY

# --- Firebase (Auth / token verify para Telegram) ---
FIREBASE_API_KEY=
FIREBASE_PROJECT_ID=
FIREBASE_APP_ID=
FIREBASE_MESSAGING_SENDER_ID=

# --- Telegram proxy (solo server) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
